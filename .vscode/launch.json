{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mGBA",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceFolder}/${workspaceFolderBasename}.elf",
            "cwd": "${workspaceFolder}",
            "gdbpath": "/opt/devkitpro/devkitARM/bin/arm-none-eabi-gdb",
            "target": "localhost:2345",
            "remote": true,
            "autorun": [
                "set architecture armv4t",
                "set confirm off",
                "set pagination off",
                "break main"
            ],
            "printCalls": true,
            // "preLaunchTask": "Run in mGBA with GDB",
            // "postDebugTask": "Kill all mGBA",
        }
    ]
}